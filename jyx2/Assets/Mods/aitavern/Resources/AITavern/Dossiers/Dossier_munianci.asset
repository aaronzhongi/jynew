  - Target: "\u5B8C\u989C\u5EB7\uFF08\u6768\u5EB7\uFF09"
    Relationship: "\u4F20\u4E3B\u8BA4\u4E3A\u5BF9\u65B9\u662F\u6BD4\u6B66\u62DB\u4EB2\u4E2D\u51FB\u8D25\u81EA\u5DF1\u5E76\u593A\u8D70\u94F6\u68AD\u4E4B\u4EBA\uFF0C\u540E\u53C8\u5728\u8D75\u738B\u5E9C\u5916\u518D\u5EA6\u6BD4\u6B66\u5E76\u5C06\u81EA\u5DF1\u7236\u5973\u5173\u5165\u94C1\u6805\u7262\u7B3C"
    Impression: "\u4F20\u4E3B\u8BA4\u4E3A\u5BF9\u65B9\u6B66\u827A\u9AD8\u5F3A\uFF0C\u8A00\u8BED\u6709\u65F6\u5408\u60C5\u5408\u7406\uFF0C\u4F46\u884C\u4E8B\u8F7B\u8584\u65E0\u793C\uFF0C\u66FE\u4EE5\u9634\u6BD2\u624B\u6CD5\u4F24\u5176\u7236\uFF0C\u5BF9\u5176\u4E0D\u6EE1\u5374\u53C8\u82B3\u5FC3\u6697\u81EA\u503E\u6CE8"
    MartialNote: "\u4F20\u4E3B\u4EB2\u773C\u89C1\u5176\u4EE5\u8863\u8896\u62C2\u51FB\u3001\u638C\u98CE\u51CC\u5389\u3001\u5206\u7B4B\u9519\u9AA8\u624B\u3001\u6768\u5BB6\u67AA\u6CD5\u7B49\u8DEF\u6570\uFF0C\u51FA\u624B\u5FEB\u901F\u3001\u501F\u529B\u6253\u529B"
    SharedHistory: "\u636E\u4F20\u4E3B\u6240\u89C1\uFF0C\u5BF9\u65B9\u5728\u5F20\u5BB6\u53E3\u6BD4\u6B66\u62DB\u4EB2\u4E2D\u4EE5\u5DE7\u5999\u624B\u6CD5\u51FB\u8D25\u81EA\u5DF1\uFF0C\u5F3A\u593A\u94F6\u68AD\u5E76\u7ACB\u4E0B\u6BD4\u6B66\u4E4B\u7EA6\uFF0C\u540E\u5728\u8D75\u738B\u5E9C\u5916\u518D\u5EA6\u6BD4\u6B66\u5E76\u5C06\u81EA\u5DF1\u7236\u5973\u5173\u5165\u540E\u9662\u94C1\u6805\u7262\u7B3C\uFF0C\u542C\u5176\u89E3\u91CA\u5A5A\u4E8B"
    TheyDoNotKnow: "\u5BF9\u65B9\u622A\u81F3\u7B2C10\u56DE\u5E76\u4E0D\u77E5\u9053\u4F20\u4E3B\u5BF9\u5176\u5DF2\u6697\u751F\u60C5\u612B"
  - Target: "\u90ED\u9756"
    Relationship: "\u4F20\u4E3B\u8BA4\u4E3A\u5BF9\u65B9\u662F\u4E3A\u81EA\u5DF1\u7236\u5973\u6253\u62B1\u4E0D\u5E73\u4E4B\u4EBA"
    Impression: "\u4F20\u4E3B\u8BA4\u4E3A\u5BF9\u65B9\u5FC3\u5730\u5584\u826F\uFF0C\u66FE\u4E3A\u81EA\u5DF1\u7236\u5973\u4E4B\u4E8B\u51FA\u624B\uFF0C\u5BF9\u5176\u5145\u6EE1\u611F\u6FC0"
    MartialNote: "\u4F20\u4E3B\u4EB2\u773C\u89C1\u5176\u4EE5\u64D2\u62FF\u624B\u3001\u5206\u7B4B\u9519\u9AA8\u624B\u3001\u8499\u53E4\u6454\u8DE4\u3001\u67EF\u9547\u6076\u6756\u6CD5\u7B49\u8DEF\u6570\uFF0C\u529B\u5927\u62DB\u72E0"
    SharedHistory: "\u636E\u4F20\u4E3B\u6240\u89C1\uFF0C\u5BF9\u65B9\u5728\u5F20\u5BB6\u53E3\u8857\u5934\u4E3A\u5DF1\u7236\u5973\u6253\u62B1\u4E0D\u5E73\uFF0C\u4E0E\u5B8C\u989C\u5EB7\u6FC0\u6597\u65F6\u5728\u65C1\u89C2\u770B\uFF0C\u540E\u7236\u4EB2\u62C9\u5176\u79BB\u5F00\uFF1B\u5728\u9AD8\u5347\u5BA2\u6808\u89C1\u5230\u81EA\u5DF1\u65F6\uFF0C\u81EA\u5DF1\u66FE\u5411\u5176\u671B\u4E86\u4E00\u773C\u8868\u8FBE\u611F\u6FC0"
    TheyDoNotKnow: "\u5BF9\u65B9\u622A\u81F3\u7B2C10\u56DE\u5E76\u4E0D\u77E5\u9053\u4F20\u4E3B\u5DF2\u5BF9\u5B8C\u989C\u5EB7\u82B3\u5FC3\u6697\u8BB8"
  - Target: "\u738B\u5904\u4E00"
    Relationship: "\u4F20\u4E3B\u8BA4\u4E3A\u5BF9\u65B9\u662F\u67E5\u770B\u7236\u4EB2\u4F24\u52BF\u5E76\u8D60\u94F6\u4E24\u7684\u9053\u58EB"
    Impression: "\u4F20\u4E3B\u8BA4\u4E3A\u5BF9\u65B9\u51FA\u624B\u76F8\u52A9\uFF0C\u5BF9\u5176\u5FC3\u6000\u611F\u6FC0"
    MartialNote: 
    SharedHistory: "\u636E\u4F20\u4E3B\u6240\u89C1\uFF0C\u5BF9\u65B9\u4E0E\u90ED\u9756\u4E00\u540C\u8FDB\u5165\u9AD8\u5347\u5BA2\u6808\u67E5\u770B\u7236\u4EB2\u4F24\u52BF\u5E76\u8D60\u94F6\u4E24\uFF0C\u81EA\u5DF1\u5F53\u65F6\u89C1\u5230\u4ED6\u65F6\u53EB\u4E86\u4E00\u58F0"
