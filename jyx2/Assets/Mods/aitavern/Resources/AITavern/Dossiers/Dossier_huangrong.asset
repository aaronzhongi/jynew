    MartialNote: "\u4F20\u4E3B\u4EB2\u773C\u89C1\u5176\u65BD\u5C55\u501F\u529B\u6253\u529B\u4E0E\u767D\u9A7C\u5C71\u5185\u529F\u8DEF\u6570"
    SharedHistory: "\u636E\u4F20\u4E3B\u6240\u89C1\uFF0C\u5176\u5E08\u53D4\u4FAF\u901A\u6D77\u7B49\u4EBA\u88AB\u4F20\u4E3B\u620F\u5F04\uFF0C\u540E\u5728\u8D75\u738B\u5E9C\u9999\u96EA\u5385\u540C\u5E2D\uFF0C\u4F20\u4E3B\u4E0E\u5176\u6BD4\u8BD5\u5E76\u4EE5\u8BE1\u8BA1\u80DC\u51FA\u4EE4\u5176\u4E0D\u5F97\u8FFD\u62E6\uFF0C\u968F\u540E\u5E26\u59EC\u59BE\u8FFD\u51FB\u4F20\u4E3B\u4E0E\u90ED\u9756"
    TheyDoNotKnow: "\u5BF9\u65B9\u8868\u793A\u4E0D\u77E5\u4F20\u4E3B\u662F\u9EC4\u836F\u5E08\u4E4B\u5973\u53CA\u8F6F\u732C\u7532\u62A4\u8EAB\u4E4B\u4E8B"
