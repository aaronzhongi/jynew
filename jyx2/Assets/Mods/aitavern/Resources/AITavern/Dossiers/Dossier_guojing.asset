    SharedHistory: "\u636E\u4F20\u4E3B\u6240\u89C1\uFF0C\u5728\u8D75\u738B\u5E9C\u5E2D\u95F4\u89C1\u9762\uFF0C\u542C\u95FB\u5176\u4E3A\u767D\u9A7C\u5C71\u5C11\u4E3B\uFF1B\u5728\u7B2C9\u56DE\u4E8E\u9999\u96EA\u5385\u7A97\u5916\u7AA5\u89C1\u5176\u4E0E\u4F17\u4EBA\u540C\u5E2D\uFF1B\u5728\u7B2C10\u56DE\u76EE\u7779\u5176\u4E0E\u9EC4\u84C9\u6BD4\u6B66\uFF0C\u540E\u89C1\u5176\u7387\u59EC\u59BE\u8FFD\u8D76\u9EC4\u84C9\uFF0C\u5E76\u5728\u6FC0\u6597\u4E2D\u4E0E\u6885\u8D85\u98CE\u4EA4\u624B"
