    SharedHistory: "\u636E\u4F20\u4E3B\u6240\u89C1\uFF0C\u5BF9\u65B9\u6D3E\u4ED6\u524D\u6765\u71D5\u4EAC\u8D74\u5B8C\u989C\u6D2A\u70C8\u4E4B\u8058\uFF0C\u4ED6\u66FE\u7387\u624B\u4E0B\u5546\u8BAE\u732E\u6C57\u8840\u5B9D\u9A6C\u7ED9\u5BF9\u65B9\u4EE5\u6C42\u5728\u4EAC\u4E2D\u805A\u4F1A\u65F6\u9732\u8138"
