  m_Script: {fileID: 11500000, guid: 83534f8764d0f754a9b385478fbffb1b, type: 3}
  m_Name: WorldCodex
  m_EditorClassIdentifier: 
  Era: "\u5357\u5B8B\u5B81\u5B97\u5E86\u5143\u5E74\u95F4\uFF0C\u7687\u5E1D\u5DF2\u5728\u4E34\u5B89\u5750\u9F99\u5EF7\u7EA6\u4E94\u5E74\u3002\u5927\u5B8B\u504F\u5B89\u6C5F\u5357\uFF0C\u5411\u91D1\u56FD\u79F0\u81E3\u7EB3\u8D21\uFF0C\u6BCF\u5E74\u8FDB\u732E\u94F6\u4E24\u7EE2\u5339\uFF0C\u6DEE\u6C34\u4E2D\u6D41\u4E3A\u754C\u3002\u91D1\u56FD\u5360\u636E\u4E2D\u539F\u5317\u65B9\uFF0C\u71D5\u4EAC\u4E3A\u5176\u7EDF\u6CBB\u4E2D\u5FC3\uFF0C\u5175\u52BF\u96C4\u5F3A\uFF0C\u5BF9\u8499\u53E4\u8BF8\u90E8\u5B9E\u884C\u7F81\u7E3B\u3001\u518C\u5C01\u4E0E\u6311\u62E8\u7B56\u7565\u3002\u8499\u53E4\u5728\u6F20\u5317\u8349\u539F\u5D1B\u8D77\uFF0C\u94C1\u6728\u771F\u52BF\u529B\u6E10\u76DB\uFF0C\u4E0E\u738B\u7F55\u3001\u672D\u6728\u5408\u7B49\u7ED3\u4E49\u4F46\u5DF2\u73B0\u5206\u5EAD\u6297\u793C\u4E4B\u52BF\uFF0C\u5B8B\u8499\u5173\u7CFB\u5C1A\u672A\u660E\u6717\u3002"
  Polities:
  - Name: "\u5927\u5B8B"
    Brief: "\u504F\u5B89\u6C5F\u5357\u7684\u5357\u65B9\u653F\u6743\uFF0C\u5B98\u540F\u8150\u8D25\uFF0C\u5BF9\u91D1\u56FD\u66B4\u884C\u65E0\u529B\u62B5\u6297\uFF0C\u5411\u91D1\u79F0\u81E3\u7EB3\u5C81\u8D21\u3002"
    Relations:
    - Target: "\u91D1"
      Text: "\u957F\u671F\u654C\u5BF9\uFF0C\u5411\u5176\u79F0\u81E3\u7EB3\u8D21"
    - Target: "\u8499\u53E4"
      Text: "\u5173\u7CFB\u672A\u660E"
  - Name: "\u91D1"
    Brief: "\u5360\u636E\u4E2D\u539F\u5317\u65B9\u7684\u5317\u65B9\u5F3A\u56FD\uFF0C\u71D5\u4EAC\u4E3A\u7EDF\u6CBB\u4E2D\u5FC3\uFF0C\u5175\u52BF\u96C4\u5F3A\uFF0C\u5BF9\u8499\u53E4\u5B9E\u884C\u7F81\u7E3B\u4E0E\u6311\u62E8\u3002"
    Relations:
    - Target: "\u5927\u5B8B"
      Text: "\u4E3A\u4E16\u4EC7\uFF0C\u63A5\u53D7\u5176\u79F0\u81E3\u7EB3\u8D21"
    - Target: "\u8499\u53E4"
      Text: "\u5B9E\u884C\u518C\u5C01\u3001\u62C9\u62E2\u4E0E\u6311\u62E8"
  - Name: "\u8499\u53E4"
    Brief: "\u6F20\u5317\u8349\u539F\u6E38\u7267\u90E8\u843D\uFF0C\u94C1\u6728\u771F\u52BF\u529B\u6E10\u5F3A\uFF0C\u5C1A\u672A\u5B8C\u5168\u7EDF\u4E00\uFF0C\u5404\u90E8\u95F4\u5F81\u6218\u4E0E\u7ED3\u4E49\u5E76\u5B58\u3002"
    Relations:
    - Target: "\u91D1"
      Text: "\u63A5\u53D7\u518C\u5C01\u4F46\u5B58\u5728\u51B2\u7A81"
    - Target: "\u5927\u5B8B"
      Text: "\u5173\u7CFB\u672A\u660E"
  Factions:
  - Name: "\u5168\u771F\u6559"
    Brief: "\u4E2D\u539F\u7384\u95E8\u6B63\u5B97\u6B66\u6797\u5927\u6D3E\uFF0C\u6559\u89C4\u4E25\u660E\uFF0C\u5F1F\u5B50\u884C\u8D70\u6C5F\u6E56\uFF0C\u638C\u6559\u9A6C\u94B0\uFF0C\u4E18\u5904\u673A\u3001\u738B\u5904\u4E00\u7B49\u4E3A\u5176\u5E08\u5144\u5F1F\u3002"
    HomeRegion: "\u4E2D\u539F"
    Relations:
    - Target: "\u6C5F\u5357\u4E03\u602A"
      Text: "\u6709\u65E7\u6028\uFF0C\u4F46\u9A6C\u94B0\u3001\u738B\u5904\u4E00\u6697\u4E2D\u503E\u5411"
  - Name: "\u6843\u82B1\u5C9B"
    Brief: "\u4E1C\u6D77\u9690\u4E16\u95E8\u6D3E\uFF0C\u5C9B\u4E3B\u9EC4\u836F\u5E08\u6B66\u529F\u5353\u7EDD\u3001\u5947\u95E8\u9041\u7532\u4E0E\u6B66\u529F\u8BE1\u5947\uFF0C\u5176\u5F1F\u5B50\u591A\u88AB\u9010\u51FA\u95E8\u5899\u3002"
    HomeRegion: "\u4E1C\u6D77"
    Relations: []
  - Name: "\u767D\u9A7C\u5C71"
    Brief: "\u897F\u57DF\u95E8\u6D3E\uFF0C\u6B27\u9633\u950B\u4E3A\u4E3B\uFF0C\u6B27\u9633\u514B\u4E3A\u5C11\u4E3B\uFF0C\u6B66\u529F\u9AD8\u5F3A\uFF0C\u5584\u501F\u529B\u6253\u529B\u4E0E\u72EC\u7279\u5185\u529F\uFF0C\u884C\u8E2A\u9690\u79D8\u3002"
    HomeRegion: "\u897F\u57DF"
    Relations: []
  - Name: "\u4E10\u5E2E"
    Brief: "\u6C5F\u6E56\u7B2C\u4E00\u5927\u5E2E\uFF0C\u5730\u4F4D\u91CD\u8981\uFF0C\u5728\u4E2D\u539F\u6D3B\u52A8\u3002"
    HomeRegion: "\u4E2D\u539F"
    Relations: []
  - Name: "\u5927\u7406\u6BB5\u6C0F"
    Brief: "\u5357\u65B9\u6B66\u6797\u4E16\u5BB6\uFF0C\u4E0E\u4E2D\u539F\u6B66\u6797\u6709\u6E0A\u6E90\uFF0C\u5C11\u6D89\u5927\u6F20\u3002"
    HomeRegion: "\u5357\u65B9"
    Relations: []
  NotableFigures:
  - Name: "\u9EC4\u836F\u5E08"
    Polity: 
    Faction: "\u6843\u82B1\u5C9B"
    OneLine: "\u4E1C\u90AA\uFF0C\u6843\u82B1\u5C9B\u5C9B\u4E3B\uFF0C\u9EC4\u84C9\u4E4B\u7236\uFF0C\u5947\u95E8\u9041\u7532\u3001\u6B66\u529F\u8BE1\u5947\u3002"
  - Name: "\u6B27\u9633\u950B"
    Polity: 
    Faction: "\u767D\u9A7C\u5C71"
    OneLine: "\u897F\u6BD2\uFF0C\u767D\u9A7C\u5C71\u4E3B\uFF0C\u6B27\u9633\u514B\u4E4B\u53D4\uFF08\u540D\u4E49\u4E0A\uFF09\uFF0C\u7528\u6BD2\u4E0E\u86E4\u87C6\u529F\u51A0\u7EDD\u3002"
  - Name: "\u90ED\u9756"
    Polity: "\u5927\u5B8B"
    Faction: 
    OneLine: "\u6C5F\u5357\u957F\u5927\u3001\u6F20\u5317\u8499\u53E4\u517B\u5927\u7684\u5C11\u5E74\uFF0C\u61A8\u539A\u6734\u62D9\uFF0C\u9EC4\u84C9\u5728\u56DE7-10\u7ED3\u8BC6\u7684\u5C11\u5E74\u3002"
  - Name: "\u5468\u4F2F\u901A"
    Polity: 
    Faction: "\u5168\u771F\u6559"
    OneLine: "\u8001\u987D\u7AE5\uFF0C\u5168\u771F\u6559\u738B\u91CD\u9633\u5E08\u5F1F\uFF0C\u6027\u60C5\u5929\u771F\uFF08\u56DE10\u4E4B\u524D\u4EE5\u542C\u95FB/\u4FA7\u9762\u4E3A\u4E3B\uFF09\u3002"
  - Name: "\u6885\u8D85\u98CE"
    Polity: 
    Faction: "\u6843\u82B1\u5C9B"
    OneLine: "\u9ED1\u98CE\u53CC\u715E\u4E4B\u4E00\uFF0C\u6843\u82B1\u5C9B\u53DB\u5F92\uFF0C\u9EC4\u836F\u5E08\u9010\u51FA\u95E8\u5899\u7684\u5973\u5F1F\u5B50\u3002"
  - Name: "\u5B8C\u989C\u6D2A\u70C8"
    Polity: "\u91D1"
    Faction: 
    OneLine: "\u91D1\u56FD\u8D75\u738B\uFF0C\u91CE\u5FC3\u52C3\u52C3\uFF0C\u8D75\u738B\u5E9C\u4E4B\u4E3B\uFF08\u56DE10\u51A4\u5BB6\u805A\u5934\u573A\u666F\u7684\u4E1C\u9053\uFF09\u3002"
  - Name: "\u5B8C\u989C\u5EB7\uFF08\u6768\u5EB7\uFF09"
    Polity: "\u91D1"
    Faction: 
    OneLine: "\u8D75\u738B\u5E9C\u5C0F\u738B\u7237\uFF0C\u6B66\u827A\u51FA\u4F17\u3001\u5FC3\u672F\u53EF\u7591\uFF08\u8EAB\u4E16\u5728\u56DE10\u4EC5\u4E3A\u7591\u70B9\uFF09\u3002"
  - Name: "\u7A46\u5FF5\u6148"
    Polity: "\u5927\u5B8B"
    Faction: 
    OneLine: "\u6BD4\u6B66\u62DB\u4EB2\u7684\u5C11\u5973\uFF0C\u521A\u70C8\u91CD\u60C5\uFF0C\u4E0E\u5B8C\u989C\u5EB7\u6709\u7EA0\u845B\u3002"
  - Name: "\u4E18\u5904\u673A"
    Polity: "\u5927\u5B8B"
    Faction: "\u5168\u771F\u6559"
    OneLine: "\u957F\u6625\u5B50\uFF0C\u5168\u771F\u4E03\u5B50\u4E4B\u4E00\uFF0C\u521A\u70C8\u4EFB\u4FA0\uFF0C\u4E0E\u6C5F\u5357\u4E03\u602A\u6709\u7EA6\u3002"
  - Name: "\u738B\u5904\u4E00"
    Polity: "\u5927\u5B8B"
    Faction: "\u5168\u771F\u6559"
    OneLine: "\u7389\u9633\u5B50\uFF0C\u5168\u771F\u4E03\u5B50\u4E4B\u4E00\uFF0C\u56DE10\u4E4B\u524D\u5728\u71D5\u4EAC\u4E00\u5E26\u4E0E\u90ED\u9756\u7B49\u6709\u4EA4\u3002"
  - Name: "\u6C99\u901A\u5929"
    Polity: "\u91D1"
    Faction: 
    OneLine: "\u9EC4\u6CB3\u56DB\u9B3C\u4E4B\u9996/\u9B3C\u95E8\u9F99\u738B\uFF0C\u53D7\u5B8C\u989C\u6D2A\u70C8\u5EF6\u63FD\u7684\u6C5F\u6E56\u597D\u624B\u3002"
  - Name: "\u5F6D\u8FDE\u864E"
    Polity: "\u91D1"
    Faction: 
    OneLine: "\u5343\u624B\u4EBA\u5C60\uFF0C\u51F6\u608D\u72E0\u8FA3\uFF0C\u53D7\u5B8C\u989C\u6D2A\u70C8\u5EF6\u63FD\u4E4B\u4E00\u3002"
  - Name: "\u6881\u5B50\u7FC1"
    Polity: "\u91D1"
    Faction: 
    OneLine: "\u53C2\u4ED9\u8001\u602A\uFF0C\u53D7\u5B8C\u989C\u6D2A\u70C8\u5EF6\u63FD\u4E4B\u4E00\uFF0C\u66FE\u4E0E\u90ED\u9756\u7ED3\u6028\u3002"
  - Name: "\u7075\u667A\u4E0A\u4EBA"
    Polity: "\u91D1"
    Faction: 
    OneLine: "\u85CF\u8FB9\u5BC6\u5B97\u9AD8\u50E7\uFF0C\u53D7\u5B8C\u989C\u6D2A\u70C8\u5EF6\u63FD\u4E4B\u4E00\uFF0C\u6B66\u529F\u521A\u731B\u3002"
  - Name: "\u9EC4\u84C9"
    Polity: 
    Faction: "\u6843\u82B1\u5C9B"
    OneLine: "\u6843\u82B1\u5C9B\u9EC4\u836F\u5E08\u4E4B\u5973\uFF0C\u7075\u52A8\u673A\u654F\u3002"
  - Name: "\u6B27\u9633\u514B"
    Polity: 
    Faction: "\u767D\u9A7C\u5C71"
    OneLine: "\u767D\u9A7C\u5C71\u5C11\u4E3B\uFF0C\u9526\u8863\u98CE\u6D41\uFF0C\u56DE10\u8D75\u738B\u5E9C\u521D\u89C1\u9EC4\u84C9\u5373\u795E\u9B42\u98D8\u8361\u3002"
